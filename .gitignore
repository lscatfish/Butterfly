# SolidWorks temp files
~$*
*.swp
*.sldprt.bak

# Python cache
__pycache__/
*.pyc
*.pyo

# IDE
.vscode/
.idea/

# Generated outputs (ignored by default)
/output/figures/*.png
/output/tables/*.csv
/output/reports/*.md
!/output/reports/gear_report.md

# Keep directory structure
!/output/
!/output/figures/
!/output/tables/
!/output/reports/

# Stability sweep data (large NPZ files, generated)
temp/stability/sweep_*/
temp/stability/figures/sweep_*/

